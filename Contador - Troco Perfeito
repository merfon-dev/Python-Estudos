# contador de troco perfeito

# Multiplicamos por 100 e convertemos para int para eliminar erro de ponto flutuante
troco_centavos = int(float(input("Digite o valor do troco: ")) * 100)

try:

    print(f"\n--- Distribuição do Troco ---")

# Notas de 100 (10000 centavos)
    notas_100 = troco_centavos // 10000
    troco_centavos %= 10000

# Notas de 50 (5000 centavos)
    notas_50 = troco_centavos // 5000
    troco_centavos %= 5000

# Notas de 20 (2000 centavos)
    notas_20 = troco_centavos // 2000
    troco_centavos %= 2000

# Notas de 10 (1000 centavos)
    notas_10 = troco_centavos // 1000
    troco_centavos %= 1000

# Notas de 5 (500 centavos)
    notas_5 = troco_centavos // 500
    troco_centavos %= 500

# Notas de 2 (200 centavos)
    notas_2 = troco_centavos // 200
    troco_centavos %= 200

# Notas de 1 (100 centavos)
    notas_1 = troco_centavos // 100
    troco_centavos %= 100

# centavos (moedas)
    moedas = troco_centavos

# Exibindo os resultados
    print(f"Notas de R$ 100: {notas_100}")
    print(f"Notas de R$ 50: {notas_50}")
    print(f"Notas de R$ 20: {notas_20}")
    print(f"Notas de R$ 10: {notas_10}")
    print(f"Notas de R$ 5: {notas_5}")
    print(f"Notas de R$ 2: {notas_2}")
    print(f"Notas de R$ 1: {notas_1}")
    print(f"Moedas (Centavos): {moedas}")

#tratando possível erro de digitação do usuário
except ValueError: 
    print("digite um valor válido")

except Exception:
    print("Tente novamente!")

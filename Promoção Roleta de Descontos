#roleta de desconto 
import random

def desconto_aleatorio(valor): #aqui calculamos um desconto aleatório entre 5 e 20%
    desconto_sorteado = random.randint(5, 20)
    valor_descontado = valor - valor*(desconto_sorteado/100) #o que o cliente pagará com desconto, já calculado na função
    return valor_descontado
    
def calcula_desconto (valor):
      valor_deduzido = valor - (valor*0.05)#o que o cliente pagará com desconto, já embutido na função 
      return valor_deduzido
      
#motor do código
try:
    print ("Bem vindos a promoção descontos aleatórios!".upper())
    nome_cliente = input("\n Nome do cliente: ")
    valor_da_compra = float(input("\n Valor da compra: "))

    if valor_da_compra <= 0: #previne cálculos com 0 ou negativo 
       print ("\nErro! O valor da compra não pode ser nulo ou negativo!")
    else:   
       if valor_da_compra > 200: #aqui, ele sobrepõe descontos caso o valor seja maior que 200
           primeiro_desconto = desconto_aleatorio(valor_da_compra)
           desconto_total = calcula_desconto(primeiro_desconto)
    
       else:   
            desconto_total = calcula_desconto(valor_da_compra)#a regra não se aplica aqui
       print (f"Cliente {nome_cliente.lower().capitalize()} paga apenas {desconto_total:.2f} com desconto!")
    
except ValueError:
    print("\n Erro! Digite o valor correto!")
    
except:    
    print("\nAlgo está errado! \nCheque as entradas e tente novamente!")  